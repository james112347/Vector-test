# Vector App - Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env itself.

# Groq AI API Key (get from console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Supabase (get from supabase.com → Project Settings → API)
# Without these, the app works in local-only mode (no cross-device sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Sahha Health API (get from sahha.ai/start → Dashboard → Credentials)
# Sandbox API: https://sandbox-api.sahha.ai
# Production API: https://api.sahha.ai
VITE_SAHHA_API_URL=https://sandbox-api.sahha.ai
# Sandbox / test: client credentials for direct auth (bypasses Edge Functions)
# In production, move these to Supabase Edge Function secrets only.
VITE_SAHHA_CLIENT_ID=your_client_id_here
VITE_SAHHA_CLIENT_SECRET=your_client_secret_here
# Webhook (server-side only)
# SAHHA_WEBHOOK_SECRET=your_webhook_secret_here
